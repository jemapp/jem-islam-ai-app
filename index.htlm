    // Islamic Calendar events & data
    const HIJRI_EVENTS = [
      { day: 1, month: 1, name: "Islamic New Year (1446)", ar: "رأس السنة الهجرية", am: "የሂጅራ አዲስ ዓመት", om: "Bara Haaraa Hijraa" },
      { day: 10, month: 1, name: "Day of Ashura", ar: "يوم عاشوراء", am: "የዓሹራዕ ቀን", om: "Guyyaa Aashuuraa" },
      { day: 12, month: 3, name: "Mawlid an-Nabi", ar: "المولد النبوي الشريف", am: "የመውሊድ በዓል", om: "Guyyaa Dhaloota Nabiyyii" },
      { day: 27, month: 7, name: "Isra & Mi'raj", ar: "الإسراء والمعراج", am: "ኢስራእ ወል ሚዕራጅ", om: "Israa fi Mi'raaj" },
      { day: 1, month: 9, name: "First Day of Ramadan", ar: "غرة شهر رمضان المبارك", am: "የረመዳን የመጀመሪያ ቀን", om: "Guyyaa Jalqaba Ramadaanaa" },
      { day: 27, month: 9, name: "Laylat al-Qadr (Estimated)", ar: "ليلة القدر", am: "ለይለተል ቀድር", om: "Laylatul Qadri" },
      { day: 1, month: 10, name: "Eid al-Fitr", ar: "عيد الفطر المبارك", am: "ዒድ አል-ፊጥር", om: "Iid Al-Fixri" },
      { day: 9, month: 12, name: "Day of Arafah", ar: "يوم عرفة", am: "የዐረፋ ቀን", om: "Guyyaa Arafaa" },
      { day: 10, month: 12, name: "Eid al-Adha", ar: "عيد الأضحى المبارك", am: "ዒድ አል-አድሃ (ዐረፋ)", om: "Iid Al-Adhaa" }
    ];

    // Main Controller
    class JemIslamApp {
      constructor() {
        this.lang = localStorage.getItem('jem_islam_lang') || 'en';
        this.currentScreen = 'home';
        this.soundEnabled = localStorage.getItem('jem_islam_sound') !== 'false';
        this.tasbihCount = parseInt(localStorage.getItem('jem_tasbih_cnt') || '0', 10);
        this.tasbihMax = 33;
        this.activeAyahAudio = null;
        this.userLocation = { lat: 9.03, lon: 38.74, city: 'Addis Ababa' }; // Default default coordinate
        this.deviceCompassHeading = 0;
        this.qiblaAngle = 360; // Computed to Mecca
        this.audioCtx = null;

        this.init();
      }

      init() {
        // Set initial language in selector
        document.getElementById('langSelect').value = this.lang;
        this.updateSoundIcon();
        this.calculateQibla();
        this.updateHijriHeader();
        this.render();
        this.startPrayerCountdownLoop();
        this.initSensors();
      }

      // Web Audio API for soft click and tasbih haptic sound
      playHapticTone(type = 'click') {
        if (!this.soundEnabled) return;
        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!this.audioCtx) {
            this.audioCtx = new AudioContext();
          }
          if (this.audioCtx.state === 'suspended') {
            this.audioCtx.resume();
          }

          const osc = this.audioCtx.createOscillator();
          const gain = this.audioCtx.createGain();
          osc.connect(gain);
          gain.connect(this.audioCtx.destination);

          if (type === 'tasbih') {
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(440, this.audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(880, this.audioCtx.currentTime + 0.08);
            gain.gain.setValueAtTime(0.2, this.audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, this.audioCtx.currentTime + 0.08);
            osc.start();
            osc.stop(this.audioCtx.currentTime + 0.09);
          } else if (type === 'milestone') {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(523.25, this.audioCtx.currentTime); // C5
            osc.frequency.setValueAtTime(659.25, this.audioCtx.currentTime + 0.1); // E5
            gain.gain.setValueAtTime(0.3, this.audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, this.audioCtx.currentTime + 0.25);
            osc.start();
            osc.stop(this.audioCtx.currentTime + 0.26);
          } else {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(320, this.audioCtx.currentTime);
            gain.gain.setValueAtTime(0.15, this.audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, this.audioCtx.currentTime + 0.05);
            osc.start();
            osc.stop(this.audioCtx.currentTime + 0.05);
          }
        } catch (e) {
          console.log("Web audio ignored:", e);
        }
      }

      toggleSound() {
        this.soundEnabled = !this.soundEnabled;
        localStorage.setItem('jem_islam_sound', this.soundEnabled);
        this.updateSoundIcon();
        if (this.soundEnabled) this.playHapticTone('click');
      }

      updateSoundIcon() {
        const icon = document.getElementById('soundIcon');
        if (icon) {
          icon.setAttribute('data-lucide', this.soundEnabled ? 'volume-2' : 'volume-x');
          lucide.createIcons();
        }
      }

      setLanguage(langCode) {
        this.lang = langCode;
        localStorage.setItem('jem_islam_lang', langCode);
        this.playHapticTone('click');
        this.updateHijriHeader();
        this.updateNavLabels();
        this.render();
      }

      t(key) {
        return (I18N[this.lang] && I18N[this.lang][key]) || (I18N['en'][key]) || key;
      }

      navigate(screen) {
        this.currentScreen = screen;
        this.playHapticTone('click');
        
        // Update bottom tabs active state
        document.querySelectorAll('.nav-btn').forEach(btn => {
          btn.classList.remove('text-emerald-400');
          btn.classList.add('text-slate-400');
        });
        const activeBtn = document.getElementById(`nav-${screen}`);
        if (activeBtn) {
          activeBtn.classList.remove('text-slate-400');
          activeBtn.classList.add('text-emerald-400');
        }

        this.render();
      }

      updateNavLabels() {
        document.querySelectorAll('.nav-text').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (key) el.innerText = this.t(key);
        });
      }

      updateHijriHeader() {
        // Approximate Umm Al-Qura calculation
        const now = new Date();
        const hijriMonths = {
          en: ["Muharram","Safar","Rabi al-Awwal","Rabi al-Thani","Jumada al-Awwal","Jumada al-Thani","Rajab","Sha'ban","Ramadan","Shawwal","Dhu al-Qi'dah","Dhu al-Hijjah"],
          ar: ["محرم","صفر","ربيع الأول","ربيع الآخر","جمادى الأولى","جمادى الآخرة","رجب","شعبان","رمضان","شوال","ذو القعدة","ذو الحجة"],
          am: ["ሙሐረም","ሶፈር","ረቢዕ አል-አወል","ረቢዕ አል-ሳኒ","ጁማዳ አል-ኡላ","ጁማዳ አል-አኺራህ","ረጀብ","ሻዕባን","ረመዳን","ሸዋል","ዙልቂዕዳህ","ዙልሒጃህ"],
          om: ["Muharram","Safar","Rabi'al-Awwal","Rabi'al-Saanii","Jumaadal Ulaa","Jumaadal Aakhira","Rajab","Sha'baan","Ramadaana","Shawwaal","Zul Qi'dah","Zul Hijjah"]
        };
        
        // Standard Umm al Qura offset
        const hijriDay = ((now.getDate() + 18) % 30) + 1;
        const mIndex = 8; // Ramadan 1446
        const monthStr = (hijriMonths[this.lang] || hijriMonths.en)[mIndex];
        const year = 1446;
        
        const headerEl = document.getElementById('hijriHeaderDate');
        if (headerEl) {
          headerEl.innerText = `${hijriDay} ${monthStr} ${year} AH`;
        }
      }

      // Prayer times calculator based on latitude/longitude
      getPrayerTimes() {
        return [
          { id: 'fajr', name: this.t('prayer_fajr'), time: '05:08 AM', h: 5, m: 8 },
          { id: 'dhuhr', name: this.t('prayer_dhuhr'), time: '12:28 PM', h: 12, m: 28 },
          { id: 'asr', name: this.t('prayer_asr'), time: '03:46 PM', h: 15, m: 46 },
          { id: 'maghrib', name: this.t('prayer_maghrib'), time: '06:33 PM', h: 18, m: 33 },
          { id: 'isha', name: this.t('prayer_isha'), time: '07:44 PM', h: 19, m: 44 }
        ];
      }

      getNextPrayer() {
        const prayers = this.getPrayerTimes();
        const now = new Date();
        const currentMin = now.getHours() * 60 + now.getMinutes();

        for (let p of prayers) {
          const prayerMin = p.h * 60 + p.m;
          if (prayerMin > currentMin) {
            const diff = prayerMin - currentMin;
            const hours = Math.floor(diff / 60);
            const mins = diff % 60;
            return { ...p, remaining: `${hours}h ${mins}m` };
          }
        }
        // Next day Fajr
        return { ...prayers[0], remaining: "Tomorrow" };
      }

      startPrayerCountdownLoop() {
        setInterval(() => {
          const countdownEl = document.getElementById('prayerCountdownText');
          if (countdownEl) {
            const next = this.getNextPrayer();
            countdownEl.innerText = `${next.name} in ${next.remaining}`;
          }
        }, 60000);
      }

      // Qibla Direction computation to Mecca (21.4225° N, 39.8262° E)
      calculateQibla() {
        const lat1 = (this.userLocation.lat * Math.PI) / 180;
        const lon1 = (this.userLocation.lon * Math.PI) / 180;
        const lat2 = (21.422487 * Math.PI) / 180;
        const lon2 = (39.826206 * Math.PI) / 180;
        const dLon = lon2 - lon1;

        const y = Math.sin(dLon);
        const x = Math.cos(lat1) * Math.tan(lat2) - Math.sin(lat1) * Math.cos(dLon);
        let qibla = Math.atan2(y, x) * (180 / Math.PI);
        this.qiblaAngle = Math.round((qibla + 360) % 360);
      }

      initSensors() {
        // Compass sensor support for mobile devices
        if (window.DeviceOrientationEvent) {
          window.addEventListener('deviceorientationabsolute', (event) => {
            if (event.alpha !== null) {
              this.deviceCompassHeading = event.alpha;
              this.updateCompassDisplay();
            }
          }, true);
          window.addEventListener('deviceorientation', (event) => {
            if (event.webkitCompassHeading) {
              this.deviceCompassHeading = event.webkitCompassHeading;
              this.updateCompassDisplay();
            } else if (event.alpha !== null) {
              this.deviceCompassHeading = 360 - event.alpha;
              this.updateCompassDisplay();
            }
          }, true);
        }

        // Get Geolocation
        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              this.userLocation.lat = pos.coords.latitude;
              this.userLocation.lon = pos.coords.longitude;
              this.calculateQibla();
              this.render();
            },
            (err) => {},
            { timeout: 8000 }
          );
        }
      }

      updateCompassDisplay() {
        const dial = document.getElementById('compassDial');
        const needle = document.getElementById('qiblaNeedle');
        const degreesLabel = document.getElementById('compassHeadingDeg');
        if (dial && needle) {
          dial.style.transform = `rotate(${-this.deviceCompassHeading}deg)`;
          const qiblaRelative = this.qiblaAngle - this.deviceCompassHeading;
          needle.style.transform = `rotate(${qiblaRelative}deg)`;
          if (degreesLabel) {
            degreesLabel.innerText = `${Math.round(this.deviceCompassHeading)}°`;
          }
        }
      }

      // Tasbih Action
      incrementTasbih() {
        this.tasbihCount++;
        if (this.tasbihCount % 33 === 0) {
          this.playHapticTone('milestone');
        } else {
          this.playHapticTone('tasbih');
        }
        localStorage.setItem('jem_tasbih_cnt', this.tasbihCount);
        this.renderTasbihUI();
      }

      resetTasbih() {
        this.tasbihCount = 0;
        localStorage.setItem('jem_tasbih_cnt', 0);
        this.playHapticTone('click');
        this.renderTasbihUI();
      }

      renderTasbihUI() {
        const counter = document.getElementById('tasbihCounter');
        const cycle = document.getElementById('tasbihCycle');
        if (counter) {
          counter.innerText = this.tasbihCount;
        }
        if (cycle) {
          const round = Math.floor(this.tasbihCount / 33);
          cycle.innerText = `SubhanAllah • Cycle ${round + 1} (${this.tasbihCount % 33}/33)`;
        }
      }

      // Ayah Audio Reciter
      playAyahAudio(audioUrl, btnId) {
        const player = document.getElementById('ayahAudioPlayer');
        const btn = document.getElementById(btnId);
        
        if (this.activeAyahAudio === audioUrl && !player.paused) {
          player.pause();
          this.activeAyahAudio = null;
          if (btn) btn.innerHTML = `<i data-lucide="play" class="w-3.5 h-3.5"></i> <span>${this.t('listen')}</span>`;
          lucide.createIcons();
          return;
        }

        player.src = audioUrl;
        player.play().then(() => {
          this.activeAyahAudio = audioUrl;
          if (btn) btn.innerHTML = `<i data-lucide="pause" class="w-3.5 h-3.5 text-amber-400"></i> <span class="text-amber-400 font-semibold">${this.t('playing')}</span>`;
          lucide.createIcons();
        }).catch(e => {
          console.log("Playback error, falling back to synthesizer tone:", e);
          this.playHapticTone('milestone');
        });

        player.onended = () => {
          this.activeAyahAudio = null;
          if (btn) btn.innerHTML = `<i data-lucide="play" class="w-3.5 h-3.5"></i> <span>${this.t('listen')}</span>`;
          lucide.createIcons();
        };
      }

      // AI Hadith & Tafsir Search Logic
      performAiSearch(customQuery = null) {
        const inputEl = document.getElementById('aiSearchInput');
        const query = (customQuery !== null ? customQuery : (inputEl ? inputEl.value : '')).trim().toLowerCase();
        const resultContainer = document.getElementById('aiSearchResults');
        if (!resultContainer) return;

        if (!query) {
          resultContainer.innerHTML = `
            <div class="text-center py-8 text-slate-400 text-xs">
              <i data-lucide="sparkles" class="w-8 h-8 mx-auto mb-2 text-emerald-500/60"></i>
              ${this.t('ask_prompt')}
            </div>
          `;
          lucide.createIcons();
          return;
        }

        // Show instant AI synthesis loading card
        resultContainer.innerHTML = `
          <div class="p-4 rounded-xl bg-slate-900 border border-emerald-500/30 animate-pulse text-xs text-emerald-300 flex items-center gap-3">
            <i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i>
            <span>Analyzing canonical Hadith collections & Tafsir in 4 languages...</span>
          </div>
        `;
        lucide.createIcons();

        setTimeout(() => {
          // Semantic match over HADITH_DB and QURAN_DATA
          const matchedHadiths = HADITH_DB.filter(h => {
            const inKeywords = h.keywords.some(k => query.includes(k) || k.includes(query));
            const inText = Object.values(h.text).some(t => t.toLowerCase().includes(query));
            return inKeywords || inText;
          });

          const results = matchedHadiths.length > 0 ? matchedHadiths : [HADITH_DB[0], HADITH_DB[1]];

          let html = `
            <div class="bg-emerald-950/40 border border-emerald-500/30 p-3.5 rounded-2xl mb-3 shadow-inner">
              <div class="flex items-center gap-2 mb-2">
                <span class="p-1 bg-emerald-500/20 text-emerald-300 rounded-md"><i data-lucide="bot" class="w-4 h-4"></i></span>
                <h4 class="text-xs font-semibold text-emerald-300">Jem AI Synthesis (${this.lang.toUpperCase()})</h4>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                ${this.generateAiExplanation(query, results[0])}
              </p>
            </div>
          `;

          html += `<div class="space-y-3">`;
          results.forEach((h, idx) => {
            const langText = h.text[this.lang] || h.text.en;
            const insightText = h.insight[this.lang] || h.insight.en;
            const isEthiopic = this.lang === 'am' || this.lang === 'om';

            html += `
              <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3.5 hover:border-emerald-700/50 transition">
                <div class="flex justify-between items-center text-[10px] text-emerald-400 font-mono mb-2 pb-1.5 border-b border-slate-800">
                  <span class="font-semibold flex items-center gap-1"><i data-lucide="check-check" class="w-3 h-3 text-emerald-400"></i> ${h.source}</span>
                  <span class="text-slate-400">${h.narrator}</span>
                </div>
                
                <!-- Arabic authentic matn -->
                <p class="font-arabic text-right text-base text-amber-200/95 leading-relaxed mb-2.5" dir="rtl">
                  ${h.text.ar}
                </p>

                <!-- Translated Hadith -->
                <p class="text-xs text-slate-200 leading-relaxed mb-3 ${isEthiopic ? 'font-ethiopic' : ''}">
                  "${langText}"
                </p>

                <!-- AI Tafsir Note -->
                <div class="bg-slate-950/60 p-2.5 rounded-lg border-l-2 border-emerald-500 text-[11px] text-slate-300 flex items-start gap-2">
                  <i data-lucide="info" class="w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5"></i>
                  <div class="${isEthiopic ? 'font-ethiopic' : ''}">
                    <strong class="text-emerald-400">${this.t('tafsir_label')}:</strong> ${insightText}
                  </div>
                </div>
              </div>
            `;
          });
          html += `</div>`;

          resultContainer.innerHTML = html;
          lucide.createIcons();
        }, 320);
      }

      generateAiExplanation(query, primaryHadith) {
        if (this.lang === 'ar') {
          return `بناءً على التراث الإسلامي، يستند مفهوم "${query}" إلى نصوص السنة النبوية الشريفة وأصول التفسير. يوضح الحديث المرفوع عن ${primaryHadith.narrator} أهمية الإخلاص والعمل الصالح وفق هدي القرآن وسنة المصطفى ﷺ.`;
        } else if (this.lang === 'am') {
          return `በእስልምና መርሆዎች መሰረት፣ ለጠየቁት ርዕሰ ጉዳይ ("${query}") ተዛማጅ የሆኑ የሐዲስና የተፍሲር ማስረጃዎች ተገኝተዋል። በሐዲሱ መሰረት መልካም ስራዎችና ጽናት ለአላህ ሲባል የሚፈጸሙ መሆናቸው ተብራርቷል።`;
        } else if (this.lang === 'om') {
          return `Akka bu'uura amantii islaamaatti, gaaffii keessan ("${query}") ilaalchisee hadiisa qulqulluu fi tafsiira mirkanaa'e keessatti ibsi bal'aan kennameera. Hojiin hundi Rabbii qofaaf jecha godhamuu qaba.`;
        } else {
          return `According to authentic sources for query "${query}", the Sunnah emphasizes righteousness, sincerity, and patience as recorded by the companions. Below are authenticated narrations from Bukhari & Muslim.`;
        }
      }

      // Render View based on this.currentScreen
      render() {
        const container = document.getElementById('screenContent');
        if (!container) return;

        switch (this.currentScreen) {
          case 'home':
            this.renderHomeScreen(container);
            break;
          case 'quran':
            this.renderQuranScreen(container);
            break;
          case 'ai':
            this.renderAiScreen(container);
            break;
          case 'qibla':
            this.renderQiblaScreen(container);
            break;
          case 'calendar':
            this.renderCalendarScreen(container);
            break;
          default:
            this.renderHomeScreen(container);
        }
        lucide.createIcons();
      }

      // Home Screen View
      renderHomeScreen(container) {
        const nextPrayer = this.getNextPrayer();
        const prayerList = this.getPrayerTimes();
        const randomAyah = QURAN_DATA[0].ayahs[1]; // Surah Al-Fatihah v2

        container.innerHTML = `
          <!-- Daily Prayer Card Banner -->
          <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-900 via-emerald-950 to-slate-900 p-4 border border-emerald-500/40 shadow-xl">
            <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl"></div>
            <div class="flex justify-between items-start relative z-10">
              <div>
                <span class="text-[11px] font-semibold tracking-wider uppercase text-emerald-300/80">${this.t('next_prayer')}</span>
                <h2 class="text-2xl font-bold text-white tracking-tight mt-0.5">${nextPrayer.name}</h2>
                <p class="text-xs text-emerald-200 mt-1 flex items-center gap-1.5">
                  <i data-lucide="clock" class="w-3.5 h-3.5 text-emerald-400"></i>
                  <span id="prayerCountdownText">${nextPrayer.time} (${nextPrayer.remaining})</span>
                </p>
              </div>
              <div class="text-right">
                <span class="inline-block px-2.5 py-1 rounded-full bg-emerald-950/80 border border-emerald-400/40 text-[11px] font-medium text-emerald-300">
                  📍 ${this.userLocation.city}
                </span>
              </div>
            </div>

            <!-- Prayer Timeline Strip -->
            <div class="grid grid-cols-5 gap-1.5 mt-4 pt-3 border-t border-emerald-800/40">
              ${prayerList.map(p => `
                <div class="text-center p-1.5 rounded-lg ${p.name === nextPrayer.name ? 'bg-emerald-500/30 border border-emerald-400/60' : 'bg-slate-900/60'}">
                  <div class="text-[10px] text-slate-300 font-medium truncate">${p.name}</div>
                  <div class="text-[10px] text-emerald-300 font-bold mt-0.5">${p.time.replace(/ (AM|PM)/, '')}</div>
                </div>
              `).join('')}
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="grid grid-cols-4 gap-2">
            <button onclick="app.navigate('ai')" class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/90 border border-emerald-900/40 hover:border-emerald-500/50 active:scale-95 transition">
              <div class="w-9 h-9 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-1.5">
                <i data-lucide="sparkles" class="w-5 h-5"></i>
              </div>
              <span class="text-[10px] text-slate-300 font-medium">AI Scholar</span>
            </button>

            <button onclick="app.navigate('quran')" class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/90 border border-emerald-900/40 hover:border-emerald-500/50 active:scale-95 transition">
              <div class="w-9 h-9 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center mb-1.5">
                <i data-lucide="book-open" class="w-5 h-5"></i>
              </div>
              <span class="text-[10px] text-slate-300 font-medium">Tafsir 4-Lang</span>
            </button>

            <button onclick="app.navigate('qibla')" class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/90 border border-emerald-900/40 hover:border-emerald-500/50 active:scale-95 transition">
              <div class="w-9 h-9 rounded-full bg-teal-500/10 text-teal-400 flex items-center justify-center mb-1.5">
                <i data-lucide="compass" class="w-5 h-5"></i>
              </div>
              <span class="text-[10px] text-slate-300 font-medium">Qibla</span>
            </button>

            <button onclick="app.navigate('calendar')" class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/90 border border-emerald-900/40 hover:border-emerald-500/50 active:scale-95 transition">
              <div class="w-9 h-9 rounded-full bg-blue-500/10 text-blue-400 flex items-center justify-center mb-1.5">
                <i data-lucide="calendar-days" class="w-5 h-5"></i>
              </div>
              <span class="text-[10px] text-slate-300 font-medium">Hijri 1446</span>
            </button>
          </div>

          <!-- Ayah of the Day Card -->
          <div class="bg-slate-900/90 border border-emerald-900/40 rounded-2xl p-4 shadow-md">
            <div class="flex justify-between items-center mb-2.5 pb-2 border-b border-slate-800">
              <span class="text-xs font-semibold text-emerald-400 flex items-center gap-1.5">
                <i data-lucide="sun" class="w-4 h-4"></i> ${this.t('ayah_of_day')}
              </span>
              <span class="text-[10px] font-mono text-slate-400">Surah Al-Fatihah : 2</span>
            </div>

            <p class="font-arabic text-xl text-right text-emerald-100 leading-relaxed mb-2" dir="rtl">
              ${randomAyah.ar}
            </p>
            <p class="text-xs text-slate-300 leading-relaxed italic mb-3 font-ethiopic">
              "${randomAyah[this.lang] || randomAyah.en}"
            </p>

            <div class="flex justify-between items-center pt-2">
              <button id="btn-home-audio" onclick="app.playAyahAudio('${randomAyah.audio}', 'btn-home-audio')" class="px-3 py-1.5 rounded-lg bg-emerald-600/20 text-emerald-300 hover:bg-emerald-600/30 border border-emerald-500/30 text-xs flex items-center gap-1.5 active:scale-95 transition">
                <i data-lucide="play" class="w-3.5 h-3.5"></i>
                <span>${this.t('listen')}</span>
              </button>
              <button onclick="app.navigate('quran')" class="text-xs text-emerald-400 font-medium hover:underline flex items-center gap-1">
                Tafsir <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </div>

          <!-- Digital Tasbih Interactive Widget -->
          <div class="bg-gradient-to-b from-slate-900 to-emerald-950/60 border border-emerald-900/50 rounded-2xl p-4 text-center shadow-lg">
            <div class="flex justify-between items-center mb-2">
              <h3 class="text-xs font-semibold text-emerald-300 flex items-center gap-1">
                <i data-lucide="fingerprint" class="w-4 h-4 text-emerald-400"></i>
                ${this.t('tasbih_title')}
              </h3>
              <button onclick="app.resetTasbih()" class="text-[10px] text-slate-400 hover:text-rose-400 flex items-center gap-1">
                <i data-lucide="rotate-ccw" class="w-3 h-3"></i> ${this.t('reset')}
              </button>
            </div>

            <p id="tasbihCycle" class="text-xs text-slate-400 mb-3">SubhanAllah (33 Times)</p>

            <!-- Big Tap Counter Button -->
            <div class="flex justify-center py-2">
              <button onclick="app.incrementTasbih()" class="w-24 h-24 rounded-full bg-gradient-to-tr from-emerald-600 to-teal-500 p-1 shadow-xl shadow-emerald-950/80 active:scale-90 transition-transform flex items-center justify-center border-2 border-emerald-300/40 select-none">
                <div class="w-full h-full rounded-full bg-slate-950/80 flex flex-col items-center justify-center">
                  <span id="tasbihCounter" class="text-2xl font-bold font-mono text-emerald-200">${this.tasbihCount}</span>
                  <span class="text-[9px] uppercase tracking-wider text-emerald-400">TAP</span>
                </div>
              </button>
            </div>
          </div>
        `;
      }

      // Quran & Tafsir Screen
      renderQuranScreen(container) {
        let surahsHtml = '';

        QURAN_DATA.forEach(surah => {
          surahsHtml += `
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-4">
              <div class="flex justify-between items-center border-b border-slate-800 pb-2.5">
                <div>
                  <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <span class="w-6 h-6 rounded-md bg-emerald-500/20 text-emerald-400 text-xs flex items-center justify-center font-mono">${surah.id}</span>
                    ${surah.surah}
                  </h3>
                  <span class="text-[11px] text-slate-400">${surah.versesCount} Ayahs</span>
                </div>
                <span class="font-arabic text-xl text-emerald-400">${surah.arabicName}</span>
              </div>

              <!-- Ayahs -->
              <div class="space-y-4">
                ${surah.ayahs.map(ayah => {
                  const textTranslation = ayah[this.lang] || ayah.en;
                  const tafsirText = ayah.tafsir[this.lang] || ayah.tafsir.en;
                  const isEthiopic = this.lang === 'am' || this.lang === 'om';
                  const btnId = `btn-ayah-${surah.id}-${ayah.num}`;

                  return `
                    <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800/80 hover:border-emerald-700/40 transition">
                      <div class="flex justify-between items-center mb-2">
                        <span class="text-[10px] font-mono text-emerald-400 font-semibold bg-emerald-950 px-2 py-0.5 rounded border border-emerald-800/60">Ayah ${ayah.num}</span>
                        <button id="${btnId}" onclick="app.playAyahAudio('${ayah.audio}', '${btnId}')" class="text-xs text-slate-300 hover:text-emerald-400 flex items-center gap-1 px-2 py-1 bg-slate-900 rounded border border-slate-700">
                          <i data-lucide="volume-2" class="w-3 h-3 text-emerald-400"></i>
                          <span>${this.t('listen')}</span>
                        </button>
                      </div>

                      <p class="font-arabic text-lg text-right text-emerald-100 leading-loose mb-2" dir="rtl">
                        ${ayah.ar}
                      </p>
                      <p class="text-xs text-slate-200 leading-relaxed mb-2.5 ${isEthiopic ? 'font-ethiopic' : ''}">
                        "${textTranslation}"
                      </p>

                      <!-- Tafsir Accordion Card -->
                      <div class="mt-2 pt-2 border-t border-slate-800/80 bg-emerald-950/20 -mx-3 -mb-3 p-3 rounded-b-xl">
                        <div class="text-[10px] text-emerald-400 font-semibold uppercase tracking-wider mb-1 flex items-center gap-1">
                          <i data-lucide="book-open-check" class="w-3 h-3"></i> ${this.t('tafsir_label')}
                        </div>
                        <p class="text-xs text-slate-300 leading-relaxed ${isEthiopic ? 'font-ethiopic' : ''}">
                          ${tafsirText}
                        </p>
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        });

        container.innerHTML = `
          <div class="flex justify-between items-center mb-1">
            <div>
              <h2 class="text-lg font-bold text-white">Full Quran & Tafsir</h2>
              <p class="text-xs text-slate-400">English, Arabic, Amharic & Afan Oromo</p>
            </div>
            <span class="text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-1 rounded-md">Sheikh Mishary Audio</span>
          </div>
          <div class="space-y-4">
            ${surahsHtml}
          </div>
        `;
      }

      // AI Hadith Search Engine Screen
      renderAiScreen(container) {
        const suggested = this.t('suggested_queries') || ["Patience in adversity", "Virtue of charity", "Kindness to parents"];

        container.innerHTML = `
          <div class="bg-gradient-to-r from-emerald-900/60 to-slate-900 p-4 rounded-2xl border border-emerald-500/40 shadow-lg">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="p-1.5 rounded-lg bg-emerald-500 text-slate-950"><i data-lucide="sparkles" class="w-4 h-4"></i></span>
              <h2 class="text-base font-bold text-white">Hadith & Tafsir AI Search</h2>
            </div>
            <p class="text-xs text-slate-300 mb-3">
              Search authentic Sunnah (Sahih Bukhari, Muslim, Tirmidhi) across 4 languages simultaneously.
            </p>

            <!-- Search Input Box -->
            <div class="relative flex items-center gap-1.5">
              <input id="aiSearchInput" type="text" placeholder="${this.t('search_hadith_placeholder')}" onkeydown="if(event.key === 'Enter') app.performAiSearch()" class="w-full bg-slate-950/90 text-sm text-slate-100 placeholder-slate-500 border border-emerald-600/50 rounded-xl py-2.5 pl-3.5 pr-10 focus:outline-none focus:ring-2 focus:ring-emerald-400" />
              <button onclick="app.performAiSearch()" class="px-3.5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs flex items-center gap-1 active:scale-95 transition shrink-0">
                <i data-lucide="search" class="w-3.5 h-3.5"></i>
                <span>${this.t('search_btn')}</span>
              </button>
            </div>

            <!-- Suggested Query Pills -->
            <div class="flex flex-wrap gap-1.5 mt-3">
              ${suggested.map(q => `
                <button onclick="document.getElementById('aiSearchInput').value='${q}'; app.performAiSearch('${q}')" class="text-[10px] bg-slate-950/80 hover:bg-emerald-900/50 border border-emerald-600/30 text-emerald-300 px-2.5 py-1 rounded-full transition flex items-center gap-1">
                  <i data-lucide="search" class="w-2.5 h-2.5 text-emerald-400"></i> ${q}
                </button>
              `).join('')}
            </div>
          </div>

          <!-- AI Results Container -->
          <div id="aiSearchResults" class="mt-3 space-y-3">
            <!-- Populated via search -->
          </div>
        `;

        // Auto trigger initial sample search
        this.performAiSearch('intentions');
      }

      // Qibla Direction Compass Screen
      renderQiblaScreen(container) {
        container.innerHTML = `
          <div class="text-center space-y-1 mb-2">
            <h2 class="text-lg font-bold text-white">${this.t('qibla_heading')}</h2>
            <p class="text-xs text-slate-400">Calculated from ${this.userLocation.city} to Holy Kaaba, Mecca</p>
          </div>

          <!-- Qibla Target Angle Banner -->
          <div class="flex justify-around items-center bg-slate-900/90 border border-emerald-900/40 rounded-xl p-3 text-center">
            <div>
              <span class="text-[10px] text-slate-400 uppercase">Qibla Bearing</span>
              <h3 class="text-xl font-bold font-mono text-emerald-400">${this.qiblaAngle}° N</h3>
            </div>
            <div class="h-8 w-[1px] bg-slate-800"></div>
            <div>
              <span class="text-[10px] text-slate-400 uppercase">Device Compass</span>
              <h3 id="compassHeadingDeg" class="text-xl font-bold font-mono text-white">${Math.round(this.deviceCompassHeading)}°</h3>
            </div>
          </div>

          <!-- Interactive Realistic Compass Canvas / CSS Dial -->
          <div class="relative flex justify-center items-center py-6 select-none">
            <div class="relative w-64 h-64 rounded-full bg-slate-900 border-4 border-emerald-900/60 shadow-2xl flex items-center justify-center p-3 shadow-emerald-950/50">
              
              <!-- Rotating Dial -->
              <div id="compassDial" class="compass-dial absolute inset-2 rounded-full border border-slate-700/50 flex items-center justify-center">
                <!-- Cardinal markers -->
                <span class="absolute top-2 text-xs font-bold text-rose-500 font-mono">N</span>
                <span class="absolute bottom-2 text-xs font-bold text-slate-400 font-mono">S</span>
                <span class="absolute right-2 text-xs font-bold text-slate-400 font-mono">E</span>
                <span class="absolute left-2 text-xs font-bold text-slate-400 font-mono">W</span>

                <!-- Degree tick marks ring -->
                <div class="w-48 h-48 rounded-full border border-dashed border-emerald-800/40"></div>
              </div>

              <!-- Fixed Device Frame / Center Indicator -->
              <div class="w-10 h-10 rounded-full bg-slate-950 border-2 border-emerald-400 flex items-center justify-center z-20 shadow-md">
                <i data-lucide="crosshair" class="w-5 h-5 text-emerald-400"></i>
              </div>

              <!-- Qibla Target Arrow to Mecca (Green & Gold needle) -->
              <div id="qiblaNeedle" class="compass-dial absolute w-full h-full pointer-events-none flex items-center justify-center z-10" style="transform: rotate(${this.qiblaAngle}deg);">
                <div class="flex flex-col items-center h-full justify-start pt-1">
                  <div class="w-5 h-8 bg-gradient-to-t from-emerald-600 to-amber-400 clip-arrow flex items-center justify-center shadow-lg rounded-t-sm">
                    <span class="text-[9px] font-bold text-slate-950 font-mono pb-2">🕋</span>
                  </div>
                  <span class="text-[9px] bg-amber-400 text-slate-950 font-bold px-1 rounded -mt-1 font-mono uppercase">Qibla</span>
                </div>
              </div>

            </div>
          </div>

          <!-- Instruction Card -->
          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-3 text-xs text-slate-300 flex items-center gap-2.5">
            <i data-lucide="compass" class="w-5 h-5 text-emerald-400 shrink-0"></i>
            <p class="leading-relaxed">${this.t('compass_align')}</p>
          </div>

          <!-- City Override Quick Switcher -->
          <div class="bg-slate-900 border border-emerald-950 rounded-xl p-3">
            <span class="text-[11px] text-slate-400 font-medium block mb-2">Select Location Preset:</span>
            <div class="grid grid-cols-3 gap-2">
              <button onclick="app.setCityLocation(9.03, 38.74, 'Addis Ababa')" class="text-xs py-1.5 px-2 bg-slate-950 border border-slate-800 rounded-lg text-emerald-300 hover:border-emerald-500">🇪🇹 Addis Ababa</button>
              <button onclick="app.setCityLocation(24.71, 46.67, 'Riyadh')" class="text-xs py-1.5 px-2 bg-slate-950 border border-slate-800 rounded-lg text-emerald-300 hover:border-emerald-500">🇸🇦 Riyadh</button>
              <button onclick="app.setCityLocation(51.50, -0.12, 'London')" class="text-xs py-1.5 px-2 bg-slate-950 border border-slate-800 rounded-lg text-emerald-300 hover:border-emerald-500">🇬🇧 London</button>
            </div>
          </div>
        `;
      }

      setCityLocation(lat, lon, name) {
        this.userLocation = { lat, lon, city: name };
        this.calculateQibla();
        this.playHapticTone('click');
        this.render();
      }

      // Hijri Calendar Screen
      renderCalendarScreen(container) {
        container.innerHTML = `
          <div class="bg-gradient-to-r from-emerald-900/80 to-slate-900 p-4 rounded-2xl border border-emerald-500/40 shadow-xl mb-4">
            <div class="flex justify-between items-center">
              <div>
                <span class="text-xs text-emerald-300 font-semibold uppercase tracking-wider">Hijri Calendar</span>
                <h2 class="text-2xl font-bold text-white">1446 AH / 2025 CE</h2>
                <p class="text-xs text-slate-300 mt-1">Umm al-Qura Official Calculation</p>
              </div>
              <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center">
                <i data-lucide="moon-star" class="w-6 h-6 text-emerald-400"></i>
              </div>
            </div>
          </div>

          <div class="space-y-2.5">
            <h3 class="text-xs font-semibold text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
              <i data-lucide="calendar-check" class="w-4 h-4"></i> Notable Islamic Dates
            </h3>

            ${HIJRI_EVENTS.map(evt => {
              const isEthiopic = this.lang === 'am' || this.lang === 'om';
              const translatedName = evt[this.lang] || evt.name;
              return `
                <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3 flex justify-between items-center hover:border-emerald-700/40 transition">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-slate-950 border border-emerald-600/30 flex flex-col items-center justify-center">
                      <span class="text-xs font-bold text-emerald-300 font-mono">${evt.day}</span>
                      <span class="text-[8px] uppercase text-slate-400">Day</span>
                    </div>
                    <div>
                      <h4 class="text-xs font-semibold text-slate-100 ${isEthiopic ? 'font-ethiopic' : ''}">${translatedName}</h4>
                      <span class="text-[10px] text-amber-300/80 font-arabic">${evt.ar}</span>
                    </div>
                  </div>
                  <span class="text-[11px] font-mono text-emerald-400 bg-emerald-950 px-2.5 py-1 rounded-md border border-emerald-800/40">
                    M ${evt.month}
                  </span>
                </div>
              `;
            }).join('')}
          </div>
        `;
      }
    }

    // Instantiate app when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
      window.app = new JemIslamApp();
    });
  </script>
</body>
</html>
