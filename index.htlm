        tafsir_label: "Tafsir Explanation",
        listen: "Listen",
        playing: "Playing...",
        source: "Source",
        compass_align: "Align compass with Qibla Kaaba arrow",
        location_error: "Compass requires device orientation permission",
        qibla_heading: "Qibla Heading",
        ayah_of_day: "Ayah of the Day",
        ai_badge: "AI Scholar Assistant",
        ask_prompt: "Ask Hadith & Tafsir questions in English, Arabic, Amharic, or Afan Oromo.",
        suggested_queries: ["Patience in adversity", "Virtue of charity", "Kindness to parents", "Prayer consistency"]
      },
      ar: {
        nav_home: "الرئيسية",
        nav_quran: "القرآن",
        nav_ai: "ذكاء الحديث",
        nav_qibla: "القبلة",
        nav_calendar: "الهجري",
        prayer_fajr: "الفجر",
        prayer_dhuhr: "الظهر",
        prayer_asr: "العصر",
        prayer_maghrib: "المغرب",
        prayer_isha: "العشاء",
        next_prayer: "الصلاة القادمة",
        search_hadith_placeholder: "ابحث عن حديث أو اسأل مسألة فقهية...",
        search_btn: "بحث ذكي",
        tasbih_title: "المسبحة الرقمية",
        reset: "إعادة ضبط",
        tafsir_label: "التفسير الميسر",
        listen: "استماع",
        playing: "جارِ التشغيل...",
        source: "المصدر",
        compass_align: "وجه الهاتف باتجاه مؤشر الكعبة المشرفة",
        location_error: "يتطلب مستشعر البوصلة وتحديد الموقع",
        qibla_heading: "اتجاه القبلة",
        ayah_of_day: "آية اليوم",
        ai_badge: "مساعد الباحث الإسلامي",
        ask_prompt: "اطرح أي سؤال في الحديث والتفسير بالعربية، الإنجليزية، الأمهرية أو عفان أورومو.",
        suggested_queries: ["الصبر عند الشدائد", "فضل الصدقة", "بر الوالدين", "فضل صلاة الفجر"]
      },
      am: {
        nav_home: "ዋና ገጽ",
        nav_quran: "ቁርኣን",
        nav_ai: "ሐዲስ AI",
        nav_qibla: "ቂብላ",
        nav_calendar: "ሂጅራ",
        prayer_fajr: "ፈጅር",
        prayer_dhuhr: "ዙህር",
        prayer_asr: "ዐስር",
        prayer_maghrib: "መግሪብ",
        prayer_isha: "ዒሻእ",
        next_prayer: "ቀጣይ ሶላት",
        search_hadith_placeholder: "ስለ ሐዲስ ወይም ስለ እስልምና ጥያቄ ይጠይቁ...",
        search_btn: "AI ፈልግ",
        tasbih_title: "ዲጂታል ተስቢህ",
        reset: "እንደገና ጀምር",
        tafsir_label: "የተፍሲር ማብራሪያ",
        listen: "አዳምጥ",
        playing: "እየተጫወተ ነው...",
        source: "ምንጭ",
        compass_align: "ስልክዎን ወደ ካዕባ አቅጣጫ አዙረው ያስተካክሉ",
        location_error: "ኮምፓስ የጂፒኤስ እና ሴንሰር ፈቃድ ይፈልጋል",
        qibla_heading: "የቂብላ አቅጣጫ",
        ayah_of_day: "የዕለቱ አንቀጽ",
        ai_badge: "ጀም ኢስላሚክ ረዳት",
        ask_prompt: "በአማርኛ፣ አፋን ኦሮሞ፣ አረብኛ ወይም እንግሊዝኛ ማንኛውንም የሐዲስ እና ተፍሲር ጥያቄ ይጠይቁ።",
        suggested_queries: ["ትዕግስት በመከራ ጊዜ", "የሶደቃ ትሩፋት", "ለወላጆች መልካም መዋል", "የሶላት አስፈላጊነት"]
      },
      om: {
        nav_home: "Fuula Duraa",
        nav_quran: "Qur'aana",
        nav_ai: "Hadiisa AI",
        nav_qibla: "Qiblaa",
        nav_calendar: "Hijraa",
        prayer_fajr: "Fajrii",
        prayer_dhuhr: "Zuhrii",
        prayer_asr: "Asrii",
        prayer_maghrib: "Maghriiba",
        prayer_isha: "Ishaa'ii",
        next_prayer: "Salaata Itti Aanu",
        search_hadith_placeholder: "Waa'ee hadiisaa ykn gaaffii islaamaa barbaadi...",
        search_btn: "AI Barbaadi",
        tasbih_title: "Tasbiihii Dijitaalaa",
        reset: "Irra Deebi'i",
        tafsir_label: "Ibsa Tafsiiraa",
        listen: "Dhaggeeffadhu",
        playing: "Taphachaa jira...",
        source: "Madda",
        compass_align: "Moobaayila keessan gara kallattii Ka'abaatti qajeelchaa",
        location_error: "Koompaasiin eeyyama argama iddoo barbaada",
        qibla_heading: "Kallattii Qiblaa",
        ayah_of_day: "Aayaata Guyyaa",
        ai_badge: "Gargaaraa Jem AI",
        ask_prompt: "Afaan Oromoo, Amaara, Arabaa fi Ingiliffaan waa'ee hadiisaa gaafadhaa.",
        suggested_queries: ["Obsa yeroo rakkinaa", "Faayidaa Sadaqaa", "Haadha fi Abbaaf tola ooluu", "Salaata jabeessuu"]
      }
    };

    // Multilingual Quran Surahs & Tafsir Dataset
    const QURAN_DATA = [
      {
        id: 1,
        surah: "Al-Fatihah",
        arabicName: "الفاتحة",
        versesCount: 7,
        ayahs: [
          {
            num: 1,
            ar: "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
            en: "In the name of Allah, the Entirely Merciful, the Especially Merciful.",
            am: "በአላህ ስም እጅግ በጣም ሩኅሩህ በጣም አዛኝ በሆነው።",
            om: "Maqaa Rabbii Akkaan Marhamaa Akkaan Rahmata Qabaataatiin.",
            tafsir: {
              en: "Opens the revelation emphasizing Allah's transcendent mercy and boundless benevolence to all creation.",
              ar: "ابتداء بطلب البركة باسم الله المستحق للعبادة وحده، الموصوف بعموم الرحمة.",
              am: "ቁርኣን የተከፈተበት ታላቅ ስም ሲሆን፤ አላህ ለፍጥረታቱ ሁሉ ያለውን አቻ የሌለው እዝነት ያሳያል።",
              om: "Eegala Qur'aanaa kan ta'e maqaa Rabbii marhamtuu ta'een jalqabamuusaa agarsiisa."
            },
            audio: "https://everyayah.com/data/Alafasy_128kbps/001001.mp3"
          },
          {
            num: 2,
            ar: "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
            en: "[All] praise is [due] to Allah, Lord of the worlds.",
            am: "ምስጋና ለአላህ ይገባው የዓለማት ጌታ ለሆነው።",
            om: "Faaruun hundi kan Rabbii Gooftaa aalama hundaa ta'eeti.",
            tafsir: {
              en: "All forms of genuine praise and absolute gratitude belong exclusively to Allah, the Cherisher and Sustainer of all existence.",
              ar: "الثناء الكامل والشكر الخالص لله وحده المربي لجميع العالمين بنعمه.",
              am: "ምስጋና ሁሉ የአለማት አስተናባሪና ፈጣሪ ለሆነው ለአላህ ብቻ የተገባ መሆኑን ያጸናል።",
              om: "Galanni fi faaruun hundumtuu kan Rabbii uumaa fi jiraachisaa aalama hundaa qofaafi."
            },
            audio: "https://everyayah.com/data/Alafasy_128kbps/001002.mp3"
          },
          {
            num: 5,
            ar: "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
            en: "It is You we worship and You we ask for help.",
            am: "አንተን ብቻ እንገዛለን፤ አንተንም ብቻ እርዳታ እንለምናለን።",
            om: "Si qofa gabbarra; Si qofarraas gargaarsa barbaanna.",
            tafsir: {
              en: "The focal point of Tawhid: Pure monotheistic worship and relying solely on divine assistance.",
              ar: "نخصك وحدك بالعبادة والدعاء، ونستعين بك وحدك في جميع أمورنا.",
              am: "የተውሂድ ዋነኛ መሠረት፤ አምልኮት ለአላህ ብቻ እንደሚገባና እገዛም ከርሱ ብቻ እንደሚፈለግ ያስተምራል።",
              om: "Utubaa Towhiidaa: Gabbartii qulqulluu Rabbiif godhuu fi Isa qofarraa gargaarsa eeggachuu."
            },
            audio: "https://everyayah.com/data/Alafasy_128kbps/001005.mp3"
          }
        ]
      },
      {
        id: 112,
        surah: "Al-Ikhlas",
        arabicName: "الإخلاص",
        versesCount: 4,
        ayahs: [
          {
            num: 1,
            ar: "قُلْ هُوَ اللَّهُ أَحَدٌ",
            en: "Say, 'He is Allah, [who is] One.'",
            am: "በል፡ እርሱ አላህ አንድ ነው።",
            om: "Jedhi: Inni Allaah tokkicha.",
            tafsir: {
              en: "Declaration of the absolute Oneness and uniqueness of Allah with no partners or equals.",
              ar: "قل أيها الرسول: الله هو المنفرد بالألوهية والربوبية لا شريك له.",
              am: "አላህ በጌትነቱና በአምላክነቱ አንድና አቻ የሌለው መሆኑን የሚመሰክር ቁልፍ አዋጅ።",
              om: "Waa'ee tokkichummaa Rabbii shariika hin qabnee labsii ifaa kenna."
            },
            audio: "https://everyayah.com/data/Alafasy_128kbps/112001.mp3"
          },
          {
            num: 2,
            ar: "اللَّهُ الصَّمَدُ",
            en: "Allah, the Eternal Refuge.",
            am: "አላህ (የሁሉ) መጠጊያ ነው።",
            om: "Allaahn Isa hundi gara Isaa dharra'u/hirkatu.",
            tafsir: {
              en: "As-Samad signifies the Self-Sufficient Master whom all creation turns to for their needs.",
              ar: "السيد الذي تصمد وتفزع إليه جميع الخلائق في قضاء حوائجها المستغني عن كل شيء.",
              am: "ፍጡራን ሁሉ የሚያስፈልጋቸውን የሚሹበት፣ እርሱ ግን ከምንም ነገር ተብቃቂ የሆነ።",
              om: "Uumamni hundi fedhii isaaniitiif kan gara Isaa deebi'an, Inni garuu homaattiyyuu hin hajamne."
            },
            audio: "https://everyayah.com/data/Alafasy_128kbps/112002.mp3"
          }
        ]
      },
      {
        id: 2,
        surah: "Ayat al-Kursi (Al-Baqarah 255)",
        arabicName: "آية الكرسي",
        versesCount: 1,
        ayahs: [
          {
            num: 255,
            ar: "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ",
            en: "Allah - there is no deity except Him, the Ever-Living, the Sustainer of all existence. Neither drowsiness overtakes Him nor sleep.",
