<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Jem Islam AI - Quran, Hadith & Qibla</title>
  <meta name="theme-color" content="#064e3b" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  
  <!-- Google Fonts: Inter, Amiri (Arabic), Noto Sans Ethiopic -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=Noto+Sans+Ethiopic:wght@400;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --font-arabic: 'Amiri', serif;
      --font-ethiopic: 'Noto Sans Ethiopic', sans-serif;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }
    .font-arabic {
      font-family: var(--font-arabic);
    }
    .font-ethiopic {
      font-family: var(--font-ethiopic);
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(16, 185, 129, 0.4);
      border-radius: 9999px;
    }
    /* Compass animation smoothing */
    .compass-dial {
      transition: transform 0.25s cubic-bezier(0.1, 1, 0.1, 1);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between overflow-x-hidden">

  <!-- App Container (Mobile Centered Frame) -->
  <div class="mx-auto w-full max-w-md min-h-screen flex flex-col bg-gradient-to-b from-emerald-950/40 via-slate-950 to-slate-950 shadow-2xl relative border-x border-emerald-900/30">
    
    <!-- Top Sticky Header -->
    <header class="sticky top-0 z-40 bg-slate-950/85 backdrop-blur-md border-b border-emerald-800/30 px-4 py-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center shadow-lg shadow-emerald-900/40 border border-emerald-400/30">
            <i data-lucide="moon" class="w-5 h-5 text-emerald-950 fill-emerald-950"></i>
          </div>
          <div>
            <h1 class="text-base font-bold tracking-tight text-white flex items-center gap-1.5">
              Jem Islam <span class="text-[10px] uppercase font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-1.5 py-0.2 rounded-full">AI</span>
            </h1>
            <p id="hijriHeaderDate" class="text-xs text-emerald-400/90 font-medium">1446 AH • Loading...</p>
          </div>
        </div>

        <!-- Language Selector Dropdown -->
        <div class="flex items-center gap-1.5">
          <div class="relative">
            <select id="langSelect" onchange="app.setLanguage(this.value)" class="bg-slate-900/90 text-emerald-300 border border-emerald-600/40 rounded-lg text-xs py-1.5 px-2.5 pr-6 focus:outline-none focus:ring-1 focus:ring-emerald-400 appearance-none font-medium cursor-pointer">
              <option value="en">🇬🇧 English</option>
              <option value="ar">🇸🇦 العربية</option>
              <option value="am">🇪🇹 አማርኛ</option>
              <option value="om">🇪🇹 Afaan Oromoo</option>
            </select>
            <i data-lucide="globe" class="w-3 h-3 text-emerald-400 absolute right-2 top-2.5 pointer-events-none"></i>
          </div>

          <!-- Audio Mute/Sound Button -->
          <button id="soundToggleBtn" onclick="app.toggleSound()" title="Sound effects" class="p-1.5 rounded-lg bg-slate-900 border border-emerald-700/30 text-emerald-400 hover:text-emerald-300 active:scale-95 transition">
            <i id="soundIcon" data-lucide="volume-2" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Scrollable Screen Content -->
    <main id="screenContent" class="flex-1 px-4 py-4 pb-24 overflow-y-auto space-y-4">
      <!-- Injected Dynamically Based On Active Tab -->
    </main>

    <!-- Bottom Mobile Navigation Bar -->
    <nav class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-md bg-slate-950/95 backdrop-blur-xl border-t border-emerald-900/40 px-2 py-2 z-50 flex justify-around items-center">
      <button onclick="app.navigate('home')" id="nav-home" class="nav-btn flex flex-col items-center gap-1 py-1 px-2.5 rounded-xl text-emerald-400 transition">
        <i data-lucide="home" class="w-5 h-5"></i>
        <span class="text-[10px] font-medium tracking-wide nav-text" data-i18n="nav_home">Home</span>
      </button>

      <button onclick="app.navigate('quran')" id="nav-quran" class="nav-btn flex flex-col items-center gap-1 py-1 px-2.5 rounded-xl text-slate-400 hover:text-emerald-300 transition">
        <i data-lucide="book-open" class="w-5 h-5"></i>
        <span class="text-[10px] font-medium tracking-wide nav-text" data-i18n="nav_quran">Quran</span>
      </button>

      <button onclick="app.navigate('ai')" id="nav-ai" class="nav-btn flex flex-col items-center gap-1 py-1 px-2.5 rounded-xl text-slate-400 hover:text-emerald-300 transition relative">
        <div class="w-5 h-5 relative flex items-center justify-center">
          <i data-lucide="sparkles" class="w-5 h-5"></i>
          <span class="absolute -top-1 -right-1.5 w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        </div>
        <span class="text-[10px] font-medium tracking-wide nav-text" data-i18n="nav_ai">Hadith AI</span>
      </button>

      <button onclick="app.navigate('qibla')" id="nav-qibla" class="nav-btn flex flex-col items-center gap-1 py-1 px-2.5 rounded-xl text-slate-400 hover:text-emerald-300 transition">
        <i data-lucide="compass" class="w-5 h-5"></i>
        <span class="text-[10px] font-medium tracking-wide nav-text" data-i18n="nav_qibla">Qibla</span>
      </button>

      <button onclick="app.navigate('calendar')" id="nav-calendar" class="nav-btn flex flex-col items-center gap-1 py-1 px-2.5 rounded-xl text-slate-400 hover:text-emerald-300 transition">
        <i data-lucide="calendar" class="w-5 h-5"></i>
        <span class="text-[10px] font-medium tracking-wide nav-text" data-i18n="nav_calendar">Hijri</span>
      </button>
    </nav>

  </div>

  <!-- Global Audio Player (Hidden element for Quran recitation) -->
  <audio id="ayahAudioPlayer" preload="none"></audio>

  <!-- Script & Application Core -->
  <script>
    /**
     * Jem Islam AI Application Engine
     * Complete offline capable dictionary, Hadith dataset, Tafsir records,
     * Prayer times calculator, and Qibla bearing system.
     */
    const I18N = {
      en: {
        nav_home: "Home",
        nav_quran: "Quran",
        nav_ai: "Hadith AI",
        nav_qibla: "Qibla",
        nav_calendar: "Hijri",
        prayer_fajr: "Fajr",
        prayer_dhuhr: "Dhuhr",
        prayer_asr: "Asr",
        prayer_maghrib: "Maghrib",
        prayer_isha: "Isha",
        next_prayer: "Next Prayer",
        search_hadith_placeholder: "Ask any question or Hadith topic...",
        search_btn: "Search AI",
        tasbih_title: "Digital Tasbih",
